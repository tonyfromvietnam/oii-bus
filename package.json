{
  "name": "oii-bus",
  "version": "0.4.0",
  "private": true,
  "description": "A cosy 3D bus touring the UK where Vietnamese students hang out, study and meet new people. Companion world to OiiMate.",
  "license": "UNLICENSED",
  "author": "Duy Chinh Dinh",
  "homepage": "https://tonyfromvietnam.github.io/oii-bus/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyfromvietnam/oii-bus.git"
  },
  "bugs": {
    "url": "https://github.com/tonyfromvietnam/oii-bus/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
