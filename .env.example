# --- Hạ tầng (docker-compose dev dùng các giá trị này) ---
DATABASE_URL=postgresql://xom:xom@localhost:5432/xom_oii?schema=public
REDIS_URL=redis://localhost:6379

# --- Bí mật (đổi ở mọi môi trường thật; `openssl rand -hex 32`) ---
SESSION_SECRET=dev-session-secret-change-me-0123456789abcdef
EMAIL_HASH_PEPPER=dev-pepper-change-me
OIIMATE_BOT_SHARED_SECRET=dev-bot-secret-change-me

# --- Email OTP dự phòng (để trống ở dev: OTP in ra console server) ---
RESEND_API_KEY=

# --- LiveKit (giá trị mặc định của `livekit-server --dev`) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Cloudflare R2 (ảnh quest, ảnh bằng chứng alumni) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- URL & cổng ---
PUBLIC_WEB_URL=http://localhost:5173
PORT=2567

# Mở phố ngoài giờ T6 19:00 → CN 23:59 (Europe/London). Chỉ dùng để test.
OPEN_OVERRIDE=false
